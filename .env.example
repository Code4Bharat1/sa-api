# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://sa_service:nexcorealliance@72.62.241.150:27037/admin?authSource=admin

# JWT
JWT_ACCESS_SECRET=your_access_secret_here_change_in_prod
JWT_REFRESH_SECRET=your_refresh_secret_here_change_in_prod
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OTP
OTP_EXPIRY_MINUTES=5

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000

# SMS (MSG91/Twilio)
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_key
MSG91_SENDER_ID=IFPD

# WhatsApp Business API
WHATSAPP_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_ID=your_phone_id

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=support@studentalliance.in

# S3-compatible Storage
S3_ENDPOINT=https://s3.amazonaws.com
S3_BUCKET=ifpd-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key

# SLA defaults (hours)
SLA_DEFAULT_RESPONSE_HOURS=4
SLA_DEFAULT_RESOLUTION_HOURS=48

# Auto-close window (days)
AUTO_CLOSE_DAYS=3

# Reopen window (days)
REOPEN_WINDOW_DAYS=7
